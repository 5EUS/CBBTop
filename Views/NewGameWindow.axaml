<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CBBTop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="120"
        x:Class="CBBTop.Views.NewGameWindow"
        x:DataType="vm:NewGameViewModel"
        Icon="/Assets/CBBTop.ico"
        Title="CBBTop - Start a new game"
        Width="300" Height="300">

    <StackPanel Margin="10" Spacing="8">
        <TextBox x:Name="FENInput"
                Width="180"
                Watermark="Enter a starting FEN position..." />

        <ComboBox x:Name="ColorInput"
                ItemsSource="{Binding AvailableColors}"
                SelectedItem="{Binding SelectedColor}"
                Margin="8"
                HorizontalAlignment="Center"
                Width="150"/> 

        <TextBox x:Name="DepthInput"
                Width="150"
                Watermark="Enter an AI depth level..." />    
        
        <TextBox x:Name="PieceValInput"
                Width="150"
                Watermark="Enter a piece value multiplier..." />      

        <TextBox x:Name="PositonalValInput"
                Width="150"
                Watermark="Enter a positional value multiplier..." />             

        <Button Content="Enter"
                Width="120"
                HorizontalAlignment="Center"
                Click="Enter_Click" />                
    </StackPanel>    

</Window>    